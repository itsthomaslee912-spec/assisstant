# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google OAuth + Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Full Pub/Sub topic name, e.g. projects/my-project/topics/gmail-push
GMAIL_PUBSUB_TOPIC=
# Optional: verify Pub/Sub push audience / email
GMAIL_PUBSUB_AUDIENCE=

# Microsoft OAuth + Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
# Client state string used to validate Graph subscription notifications
MICROSOFT_WEBHOOK_CLIENT_STATE=change-me-to-a-long-random-string

# App
DATABASE_URL=sqlite:///./email_checker.db
TOKEN_ENCRYPTION_KEY=
# Public HTTPS base URL for webhooks (ngrok / cloudflare tunnel)
WEBHOOK_BASE_URL=https://your-tunnel.example
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
SESSION_SECRET=change-me-session-secret
# Max Inbox messages to fetch on Sync (paged). Raise if you need more history.
MAIL_SYNC_MAX=10000
